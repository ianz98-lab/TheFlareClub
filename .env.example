# Copia este archivo como .env.local para desarrollo. Nunca subas llaves reales al repo.
# Detalle de cuentas y pagos: docs/06-cuentas-y-pagos.md

# --- Supabase: web (navegador) ---
# URL del proyecto y llave pública (anon o sb_publishable_…). Son públicas por diseño: la
# seguridad la da RLS. Sin ellas la web corre en "modo demo" (cuentas y actividad solo en el
# navegador). En GitHub Pages van como variables del repo (Settings → Secrets and variables →
# Actions → Variables) con estos mismos nombres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase: solo servidor ---
# Service role: salta RLS. Nunca con prefijo NEXT_PUBLIC_ ni en el navegador. Las Edge
# Functions ya la reciben de Supabase; aquí solo sirve para scripts locales.
SUPABASE_SERVICE_ROLE_KEY=

# --- Recurrente (pagos en Guatemala): secretos de las Edge Functions ---
# Se cargan en Supabase, no en la web:
#   npx supabase secrets set RECURRENTE_SECRET_KEY=sk_live_… RECURRENTE_WEBHOOK_SECRET=whsec_…
# RECURRENTE_SECRET_KEY: Recurrente → Configuración → Desarrolladores y API. sk_test_… para
#   pruebas (idealmente de un Sandbox), sk_live_… para cobrar de verdad. Crea checkouts y lee suscripciones.
# RECURRENTE_WEBHOOK_SECRET: whsec_… del endpoint del webhook (dashboard de Svix en Recurrente).
RECURRENTE_SECRET_KEY=
RECURRENTE_WEBHOOK_SECRET=
# La API actual de Recurrente ya no usa la llave pública; queda por si se usa el checkout embebido.
RECURRENTE_PUBLIC_KEY=

# --- Opcionales de la función crear-checkout (también con `supabase secrets set`) ---
# SITE_URL: URL base del sitio para volver tras pagar si la web no manda successUrl/cancelUrl.
# ALLOWED_ORIGINS: orígenes extra, separados por coma, además de https://ianz98-lab.github.io,
#   http://localhost:3000 y https://theflare.club (p. ej. un preview de Vercel).
SITE_URL=https://ianz98-lab.github.io/TheFlareClub
ALLOWED_ORIGINS=

# --- Video privado (Vimeo recomendado; alternativa: Mux) ---
VIDEO_PROVIDER=vimeo
VIMEO_ACCESS_TOKEN=

# --- Sitio ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
